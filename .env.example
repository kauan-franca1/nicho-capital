# Nicho Capital — copie para .env e preencha. Nunca commite o .env.
# Todas as chaves são opcionais: sem nenhuma, use DEMO_MODE=true.

# --- Modo de execução ---
# true = o site lê o snapshot em demo/ e não precisa de banco, internet nem chaves.
DEMO_MODE=true

# --- Banco (Supabase Free ou Postgres local via docker compose) ---
# Local: postgresql://nicho:nicho@localhost:54329/nicho
DATABASE_URL=

# --- LLMs (free tiers; cotas em config/llm.yaml) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Ollama local (https://ollama.com). Padrão do Ollama:
OLLAMA_BASE_URL=http://localhost:11434

# --- Cotações ---
# brapi.dev (fallback; opcional, plano gratuito)
BRAPI_TOKEN=

# --- Coleta ---
# Identifica o coletor nas requisições (boa prática com fontes públicas).
COLLECTOR_USER_AGENT=NichoCapital/0.1 (projeto educacional; contato: seu-email@exemplo.com)
